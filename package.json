{
  "name": "omnivoice-ai",
  "version": "1.1.0",
  "description": "Real-Time Bidirectional Speech-to-Speech AI Meeting Translator for Google Meet, Zoom, and Teams with Floating Captions.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "desktop": "electron .",
    "build:exe": "electron-packager . OmniVoiceAI --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|\\.git)\"",
    "agent": "python desktop_agent.py"
  },
  "keywords": [
    "speech-to-speech",
    "real-time-translation",
    "google-meet-translator",
    "zoom-translator",
    "speech-recognition",
    "text-to-speech",
    "virtual-audio-cable",
    "omnivoice"
  ],
  "author": "Rajesh Sahu",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-packager": "^17.1.2"
  }
}
